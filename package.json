{
  "name": "gamedashboard",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app:install": "bash infra/prod/app.sh install",
    "app:setup": "bash infra/prod/app.sh setup",
    "app:update": "bash infra/prod/app.sh update",
    "app:backup": "bash infra/prod/app.sh backup",
    "app:start": "bash infra/prod/app.sh start",
    "app:stop": "bash infra/prod/app.sh stop",
    "app:restart": "bash infra/prod/app.sh restart",
    "app:status": "bash infra/prod/app.sh status",
    "app:logs": "bash infra/prod/app.sh logs",
    "app:admin": "bash infra/prod/app.sh admin",
    "app:password": "bash infra/prod/app.sh password",
    "app:wings": "bash infra/prod/app.sh wings",
    "app:release": "bash infra/prod/app.sh release",
    "app:help": "bash infra/prod/app.sh help",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @gamedashboard/web dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "openapi": "pnpm --filter @gamedashboard/contracts openapi",
    "eggs:build": "pnpm --filter @gamedashboard/api exec tsx ../../infra/eggs/build.mts",
    "e2e": "pnpm --filter @gamedashboard/web e2e",
    "storybook": "pnpm --filter @gamedashboard/ui storybook",
    "services:up": "docker compose -f infra/docker/compose.dev.yml up -d",
    "services:down": "docker compose -f infra/docker/compose.dev.yml down",
    "services:logs": "docker compose -f infra/docker/compose.dev.yml logs -f",
    "db:generate": "pnpm --filter @gamedashboard/db db:generate",
    "db:check": "pnpm --filter @gamedashboard/db db:check",
    "db:migrate": "pnpm --filter @gamedashboard/db db:migrate",
    "db:studio": "pnpm --filter @gamedashboard/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "esbuild": "^0.28.2",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  }
}
