# Images des outils de la CI, épinglées par empreinte : une image qui change
# sous le même nom changerait le verdict sans que le dépôt bouge. Lu par
# `source` dans les workflows (ci.yml, release.yml).
IMAGE_TRIVY=aquasec/trivy@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969 # 0.74.0
IMAGE_GO=golang@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 # 1.27.1-bookworm
IMAGE_SEMGREP=semgrep/semgrep@sha256:32e459968daabe7ab86968184a29109b9564aa00392401156f9788452b42786b # 1.178.0
# CodeQL (workflow codeql.yml) : l'archive officielle du CLI et de ses
# requêtes, publiée par github/codeql-action, vérifiée par son SHA-256 avant
# d'être extraite dans le volume de cache `gd-ci-codeql`.
CODEQL_VERSION=2.27.1
CODEQL_SHA256=1d380f79896ededc654c7b21fafb3360136f1aeb678ad4df4df9af3910c6b815 # codeql-bundle-linux64.tar.gz
