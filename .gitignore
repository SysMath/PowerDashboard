node_modules/
.pnpm-store/
.turbo/
.next/
# Construction autonome de l'interface (archive qui se met à jour seule).
.next-autonome/
dist/
out/
coverage/
storybook-static/
playwright-report/
test-results/
*.log
.DS_Store
Thumbs.db

# Environnement : jamais versionné, à aucun niveau de l'arbre. Seuls les
# modèles `.env.example` le sont. Une clé poussée une fois est une clé à
# révoquer, même si le commit est retiré ensuite.
**/.env
**/.env.*
!**/.env.example

# Clés et certificats : aucun n'a sa place dans le dépôt.
*.pem
*.key
*.p12
*.pfx

# Contient le jeton du node : se télécharge depuis /admin/nodes.
infra/docker/wings/config.yml

# Réglages Claude Code propres à un poste (outils locaux, permissions).
.claude/settings.local.json

# Rapport du scan ZAP (infra/ci/zap-baseline.sh)
zap-rapport/

# Cache incrémental de TypeScript, réécrit à chaque construction.
*.tsbuildinfo

# Binaire de l'agent de node, construit dans agent/.
/agent/gamedashboard-agent
