{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.next-autonome",
      "!**/dist",
      "!**/.turbo",
      "!**/storybook-static",
      "!packages/db/migrations",
      "!**/test-results",
      "!**/playwright-report",
      "!.claude/worktrees",
      "!openapi.json",
      "!infra/eggs/*/egg.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "css": {
    "parser": { "cssModules": false, "tailwindDirectives": true }
  },
  "overrides": [
    {
      "includes": ["infra/**"],
      "linter": { "rules": { "suspicious": { "noUndeclaredEnvVars": "off" } } }
    }
  ]
}
