# Copiez ce fichier en .env. Il n'est pas versionné.

# Base de données. Les identifiants de développement viennent du compose
# (infra/docker/compose.dev.yml) et ne valent que sur cette machine.
DATABASE_URL=postgres://gamedashboard:gamedashboard@localhost:5432/gamedashboard

# Clé de chiffrement des secrets stockés : jetons de node, mots de passe de
# bases de données, secrets de webhooks (§5.4).
#
# Elle est indispensable et n'a pas de valeur par défaut : sans elle, l'API
# refuse de démarrer plutôt que d'écrire des secrets en clair. La perdre rend
# illisibles tous les secrets déjà stockés — il faut alors réémettre les jetons
# de node, pas seulement remettre une clé.
#
# Au moins 32 caractères, sans quoi l'API refuse de démarrer (le sel de
# dérivation est public : une clé courte se devine sur une copie de la base).
# Tirée au hasard, jamais réutilisée ailleurs :
#   openssl rand -base64 48
APP_SECRET_KEY=

# Port d'écoute de l'API.
PORT=3201

# Interface d'écoute. `0.0.0.0` en conteneur ; sur un hôte partagé,
# `127.0.0.1` pour que seul nginx décide de ce qui sort.
HOST=0.0.0.0

# Intermédiaires dont les en-têtes X-Forwarded-* sont crus, séparés par des
# virgules. La boucle locale par défaut : c'est de là que parlent nginx et le
# rendu. Ne jamais mettre `true` : tout appelant serait cru.
# La même liste décide si l'en-tête de pays `CF-IPCountry` est lu pour les
# alertes de connexion. Sans frontal Cloudflare, nginx doit le vider — ce que
# fait infra/prod/panel.conf ; sinon le visiteur choisirait son pays.
TRUSTED_PROXIES=127.0.0.1, ::1

# Origine autorisée pour les requêtes du navigateur (CORS avec cookies).
PANEL_ORIGIN=http://localhost:3000

# TLS vers les bases. `require` impose une connexion chiffrée ; vide, la
# connexion suit ce que le serveur propose. À poser dès que la base n'est pas
# sur la même machine.
DATABASE_SSL=
MYSQL_TLS=

# Catalogue CurseForge. Lu ici, jamais par l'interface : le navigateur passe
# par l'API, qui ajoute la clé.
#
# Format bcrypt, avec des « $ » : entre guillemets simples si votre chargeur
# d'environnement les interprète. Sans clé, la source reste simplement
# inactive — Modrinth, qui n'en demande aucune, fonctionne seul.
CURSEFORGE_API_KEY=

# --- Notifications poussées vers l'application mobile (ADR 0010) ---
# Sans rien, l'application relève la cloche à l'ouverture.
# Jeton d'accès Expo de l'éditeur (« sécurité renforcée ») : les instances de
# l'éditeur seulement, qui envoient alors en direct. Jamais dans le dépôt.
EXPO_ACCESS_TOKEN=
# Toute autre instance passe par le relais de l'éditeur, en https:// :
# l'application n'en suit pas d'autre.
PUSH_RELAY_URL=
# `aucune` refuse le relais même si l'adresse est posée.
PUSH_MODE=
# `1` : cette instance sert aussi de relais aux autres (avec EXPO_ACCESS_TOKEN).
PUSH_RELAY=

# --- Hébergement cPanel (archive autonome), sans objet ailleurs ---
# Le panel s'y met à jour de lui-même depuis les releases GitHub
# (docs/hebergement-cpanel.md). `0` coupe la mise à jour automatique.
GAMEDASHBOARD_MISE_A_JOUR=
# Secret partagé avec le workflow de release (secret PANEL_SIGNAL_SECRET du
# dépôt), 32 caractères au moins : une release publiée prévient aussitôt le
# panel au lieu d'attendre sa vérification suivante. Vide, pas de signal.
GAMEDASHBOARD_SIGNAL_SECRET=
